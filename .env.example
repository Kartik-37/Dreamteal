# DreamTeal Environment Configuration Template
# Copy this file to .env and provide your local credentials.
# NEVER commit your real .env file to version control.

# Django Security
DEBUG=True
SECRET_KEY=django-insecure-dreamteal-dev-key-change-in-production-^5x7#
ALLOWED_HOSTS=127.0.0.1,localhost,testserver

# Third-Party External Metadata Providers (Server-Side Only)
# Never expose these to the browser or frontend React bundle.

# TMDB (The Movie Database) - Movies & TV Series
# Obtain from https://www.themoviedb.org/settings/api
TMDB_ACCESS_TOKEN=
TMDB_API_KEY=

# RAWG (Video Game Database) - Games
# Obtain from https://rawg.io/apidocs
RAWG_API_KEY=

# AniList (Manga / Manhwa) - Public GraphQL API, no key required
# Jikan (Manga / Manhwa Fallback) - Public REST API, no key required

# Provider Regionalization & Streaming Settings
# Configures the ISO 3166-1 alpha-2 region code for TMDB OTT watch providers (e.g. IN, US, GB, JP)
DEFAULT_PROVIDER_REGION=IN

# Cache & Sync Settings
CATALOG_SYNC_FRESHNESS_HOURS=24
PROVIDER_HTTP_TIMEOUT=8
