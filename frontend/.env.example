# DreamTeal Frontend Environment Configuration
# NOTE: Never store backend secret keys, database passwords, or third-party API keys (TMDB, RAWG, etc.) here.
# All external metadata API keys belong strictly on the server-side Django environment.

# Base URL for the Django REST API backend
# In local development using the Vite dev server proxy, leave empty or use '/' to proxy via vite.config.js.
# For cross-origin or production deployments, specify the absolute URL (e.g., http://127.0.0.1:8000).
VITE_API_BASE_URL=

# Port for local Vite dev server (default: 5173)
VITE_PORT=5173
